<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Compass" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.Compass.Splash" parent="Theme.SplashScreen">
